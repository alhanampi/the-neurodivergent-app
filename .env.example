# Copy this file to .env.local (gitignored) and fill in real values.
# Get these from https://dashboard.clerk.com → your app → API Keys.

# Client-side — Vite only exposes VITE_-prefixed vars to the browser bundle.
# This is Clerk's *publishable* key: it's meant to be public, not a secret.
VITE_CLERK_PUBLISHABLE_KEY=

# Server-side only — used by /api routes (added in v0.5.0 for the Clerk
# webhook). Never prefix this with VITE_, or it would ship in the client
# bundle. Set it in Vercel's Environment Variables for deployed environments.
CLERK_SECRET_KEY=
