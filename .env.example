# Copy this file to .env.local (gitignored) and fill in real values.

# --- Clerk (https://dashboard.clerk.com → your app → API Keys) ---

# Client-side — Vite only exposes VITE_-prefixed vars to the browser bundle.
# This is Clerk's *publishable* key: it's meant to be public, not a secret.
VITE_CLERK_PUBLISHABLE_KEY=

# Server-side only — used by /api routes. Never prefix this with VITE_, or
# it would ship in the client bundle. Set it in Vercel's Environment
# Variables for deployed environments.
CLERK_SECRET_KEY=

# Server-side only — from Clerk dashboard → Webhooks → your endpoint →
# Signing Secret. Only exists once you've created the webhook (needs a
# public URL to point at), so this stays empty for pure local dev.
CLERK_WEBHOOK_SECRET=

# --- Neon (https://neon.tech, or Vercel's Storage tab → Neon integration) ---

# Server-side only. Connection string for the Neon Postgres database, used
# by /api routes and drizzle-kit (migrations). If provisioned through
# Vercel's native integration, Vercel sets this automatically for deployed
# environments — you still need it here for local dev.
DATABASE_URL=

# --- Groq (https://console.groq.com/keys) ---

# Server-side only — used by /api/chat and /api/chat-plan. Never prefix this
# with VITE_. Set it in Vercel's Environment Variables for deployed
# environments.
GROQ_API_KEY=

# --- E2E testing (optional) ---

# Only needed to run `npm run test:e2e` against a real Clerk sign-in. Without
# these, e2e/chat-to-tasks.spec.ts skips itself. Create a dedicated test user
# in Clerk's dashboard (test mode) rather than reusing a personal account.
E2E_CLERK_TEST_EMAIL=
E2E_CLERK_TEST_PASSWORD=
